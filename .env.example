# Copy this file to `.env` and fill in real values before running
# `docker compose up`. Never commit the real `.env` file.

# ---- Stock API ----
# Get a free key at https://www.alphavantage.co/support/#api-key
STOCK_API_KEY=your_alpha_vantage_api_key_here
STOCK_API_PROVIDER=alpha_vantage
# Comma-separated ticker symbols to fetch every run
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA

# ---- Postgres superuser (used only for bootstrapping roles/databases) ----
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_super_secret

# ---- Application database (stock_prices table) ----
STOCK_DB_NAME=stock_data
STOCK_DB_USER=stock_user
STOCK_DB_PASSWORD=change_me_stock_password

# ---- Airflow metadata database ----
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=change_me_airflow_password

# ---- Airflow admin UI login ----
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin_password

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
